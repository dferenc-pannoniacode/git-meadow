@using Microsoft.JSInterop
@inject IJSRuntime JS

<div @ref="_menu" class="context-menu" popover="@(Pointer?.Type == "contextmenu" ? "manual" : "auto")" role="group" aria-label="@Label">
    @ChildContent
</div>

@code {
    private const string ModulePath = "./Components/Workbench/ContextMenu.razor.js";
    private const string ShowMethod = "show";

    [Parameter] public MouseEventArgs? Pointer { get; set; }
    [Parameter] public ElementReference? Anchor { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    private ElementReference _menu;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            await module.InvokeVoidAsync(ShowMethod, _menu, Pointer?.ClientX ?? 0, Pointer?.ClientY ?? 0, Anchor);
        }
        catch (JSDisconnectedException)
        {
            // The browser can disconnect while the menu is opening.
        }
    }
}
